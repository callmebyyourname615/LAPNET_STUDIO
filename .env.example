# Development only. `pnpm dev:db` creates a private .env with random credentials.
LAPNET_ENV=development
APP_ORIGIN=http://127.0.0.1:5173
API_HOST=127.0.0.1
API_PORT=3100
DATABASE_URL=postgresql://lapnet_runtime:REPLACE_RUNTIME_PASSWORD@127.0.0.1:55432/lapnet_dev
MIGRATION_DATABASE_URL=postgresql://lapnet_migrator:REPLACE_MIGRATOR_PASSWORD@127.0.0.1:55432/lapnet_dev
# Container bootstrap only; never include these credentials in the API image.
POSTGRES_PASSWORD=REPLACE_BOOTSTRAP_PASSWORD
RUNTIME_PASSWORD=REPLACE_RUNTIME_PASSWORD
MIGRATOR_PASSWORD=REPLACE_MIGRATOR_PASSWORD
RELEASE_REVISION=development
# Document bytes must be backed up together with PostgreSQL. Default: .local/storage.
# STORAGE_ROOT=/absolute/path/to/private/document-storage
# Worker scans through a local ClamAV daemon; missing/stale signatures block downloads.
# CLAMAV_SIGNATURE_FILE=/absolute/path/to/clamav/daily.cld
# CLAMD_SOCKET=/absolute/path/to/clamd.sock
# CLAMD_PORT=3310
