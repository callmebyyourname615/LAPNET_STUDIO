{
  "name": "@lapnet/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "pnpm --filter @lapnet/api dev",
    "auth:bootstrap": "node scripts/bootstrap-admin.ts",
    "test:identity": "node scripts/test-identity.ts",
    "dev:db": "node scripts/dev-database.ts start",
    "db:stop": "node scripts/dev-database.ts stop",
    "db:generate": "pnpm --filter @lapnet/database generate",
    "db:migrate": "pnpm --filter @lapnet/database migrate",
    "db:seed": "pnpm --filter @lapnet/database seed",
    "db:verify": "node scripts/verify-database.ts",
    "db:backup": "node scripts/backup.ts",
    "db:restore-check": "node scripts/restore-check.ts",
    "build:web": "vite build",
    "build:backend": "pnpm -r --filter './packages/**' --filter './apps/**' build",
    "build": "pnpm build:backend && pnpm build:web",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json && pnpm -r --filter './packages/**' --filter './apps/**' typecheck",
    "test": "pnpm --filter @lapnet/api test",
    "lint": "eslint --flag unstable_native_nodejs_ts_config apps/api/src apps/api/test packages/contracts/src packages/database/src packages/database/prisma.config.ts scripts",
    "format:check": "oxfmt --check apps/api/src apps/api/test packages/contracts/src packages/database/src/index.ts packages/database/src/seed.ts packages/database/prisma.config.ts scripts eslint.config.ts",
    "api:openapi": "pnpm --filter @lapnet/api openapi",
    "preview": "vite preview",
    "format": "oxfmt",
    "test:tasks": "node scripts/test-identity.ts tasks",
    "test:team": "node scripts/test-identity.ts team",
    "test:mentions": "node --test scripts/mention-text.test.ts",
    "test:notifications": "node scripts/test-identity.ts notifications",
    "dev:worker": "pnpm --filter @lapnet/api worker",
    "test:business": "node scripts/test-identity.ts business",
    "test:documents": "node scripts/test-identity.ts documents",
    "test:account": "node scripts/test-identity.ts account",
    "test:audit": "node scripts/test-identity.ts audit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@gsap/react": "2.1.2",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "2.1.1",
    "glimm": "0.4.1",
    "gsap": "3.15.1",
    "lucide-react": "1.70.0",
    "pdfjs-dist": "6.5.438",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-easy-crop": "^6.2.5",
    "react-router-dom": "7.18.5",
    "tailwind-merge": "3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@lapnet/contracts": "workspace:*",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "dotenv": "17.3.1",
    "eslint": "10.14.0",
    "oxfmt": "^0.76.0",
    "pg": "8.23.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "8.72.1",
    "vite": "^8.0.5"
  },
  "engines": {
    "node": ">=24.11 <25"
  },
  "packageManager": "pnpm@10.18.0"
}
